@model IEnumerable<SIGH_PracticaHospital.Models.Medico>

@{
    ViewData["Title"] = "Gestión de Médicos";
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1><i class="bi bi-person-hearts"></i> Médicos</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Médicos</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Medicos/Create" class="btn btn-primary btn-action">
                <i class="bi bi-plus-circle"></i> Nuevo Médico
            </a>
        </div>
    </div>
</div>

<div class="filter-section">
    <h5><i class="bi bi-funnel"></i> Búsqueda y Filtros</h5>
    <form method="get" action="/Medicos/Index" class="row g-3">
        <div class="col-md-4">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="searchString" class="form-control" placeholder="Buscar por nombre o cédula profesional..." value="@ViewBag.SearchString" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="especialidadId" class="form-select">
                <option value="">-- Todas las especialidades --</option>
                @if (ViewBag.Especialidades != null)
                {
                    @foreach (var esp in ViewBag.Especialidades)
                    {
                        <option value="@esp.EspecialidadId" selected="@(ViewBag.EspecialidadId == esp.EspecialidadId.ToString())">@esp.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select">
                <option value="">-- Todos los estados --</option>
                <option value="Activo" selected="@(ViewBag.Estado == "Activo")">Activos</option>
                <option value="Inactivo" selected="@(ViewBag.Estado == "Inactivo")">Inactivos</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
    </form>
</div>

@if (Model.Count() == 0)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle"></i>
        <strong>Sin resultados.</strong> No se encontraron médicos con los criterios de búsqueda.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <span class="badge bg-light text-dark">Total: @Model.Count() médico(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <i class="bi bi-person-hearts"></i> Nombre
                        </th>
                        <th>
                            <i class="bi bi-card-text"></i> Cédula Profesional
                        </th>
                        <th>
                            <i class="bi bi-briefcase"></i> Especialidad
                        </th>
                        <th>
                            <i class="bi bi-door-closed"></i> Consultorio
                        </th>
                        <th>
                            <i class="bi bi-telephone"></i> Teléfono
                        </th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@Html.DisplayFor(modelItem => item.Nombre) @Html.DisplayFor(modelItem => item.Apellido)</strong>
                            </td>
                            <td>
                                <code>@Html.DisplayFor(modelItem => item.CedulaProfesional)</code>
                            </td>
                            <td>
                                <span class="badge bg-info">@item.Especialidad.Nombre</span>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NumeroConsultorio)
                            </td>
                            <td>
                                <a href="tel:@item.Telefono">@Html.DisplayFor(modelItem => item.Telefono)</a>
                            </td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge-status badge-activo">
                                        <i class="bi bi-check-circle"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inactivo">
                                        <i class="bi bi-x-circle"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="action-buttons">
                                    <a href="@Url.Action("Details", new { id = item.MedicoId })" class="btn btn-info btn-sm" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.MedicoId })" class="btn btn-warning btn-sm" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
